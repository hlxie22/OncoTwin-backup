# Production-like local stack. Slurm preview uses SQLite/local storage unless overridden.
ONCOTWIN_ENVIRONMENT=development
ONCOTWIN_DATABASE_URL=postgresql+psycopg://oncotwin:oncotwin@127.0.0.1:5432/oncotwin
ONCOTWIN_STORAGE_BACKEND=s3
ONCOTWIN_S3_BUCKET=oncotwin
ONCOTWIN_S3_ENDPOINT_URL=http://127.0.0.1:9000
ONCOTWIN_S3_ACCESS_KEY_ID=oncotwin
ONCOTWIN_S3_SECRET_ACCESS_KEY=oncotwin-dev-secret
ONCOTWIN_TASKS_EAGER=false
ONCOTWIN_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
ONCOTWIN_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
ONCOTWIN_JWT_SECRET=CHANGE_ME
ONCOTWIN_EXTRACTOR_PROVIDER=openai
ONCOTWIN_OPENAI_API_KEY=
ONCOTWIN_OPENAI_MODEL=gpt-5.6
